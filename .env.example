# Application Settings
APP_NAME=FastAPI Base
APP_VERSION=0.1.0
DEBUG=True

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/fastapi_base
# Alternative async version (if using asyncpg):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/fastapi_base

# PostgreSQL Connection Details (for reference/alembic)
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_base

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
